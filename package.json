{
  "name": "masp-synthetic-dashboard",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "test:masp": "node --test test/masp.test.mjs",
    "validate:data": "node scripts/validate_synthetic_data.mjs",
